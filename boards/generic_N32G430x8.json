{
    "build": {
      "core": "N32G430",
      "cpu": "cortex-m4",
      "mcu": "n32g430",
      "extra_flags": "-DN32G430",
      "ldscript": "n32g430_flash.ld"
    },
    "debug": {
      "jlink_device": "N32G430x8",
